/* Base build: display only. The Wi-Fi node lives in overlays/dev-iface.overlay
 * or overlays/real-card.overlay, neither of which builds on upstream Zephyr.
 */

&sdl_dc {
	compatible = "zephyr,sdl-dc";
	height = <900>;
	width = <480>;
};
